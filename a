#!/usr/bin/env bash
set -Eeuo pipefail

LOG=/root/arch-bootstrap.log
exec > >(tee -a "$LOG") 2>&1
trap 'rc=$?; echo; echo "BOOTSTRAP FAILED at line $LINENO (exit $rc)"; echo "Log: $LOG"; exit $rc' ERR

USER_NAME=magetsu
HOST_NAME=predator
ROOT_PARTUUID=ebefec21-13f8-42b7-b541-be2fa2ffe13f
BOOT_PARTUUID=54b861fd-685c-476f-b580-3051c1ba7d79
ROOT_UUID=ce979d1c-c145-4be0-9ce3-591b6fd0a3a1
BOOT_UUID=30B5-B3B9
BACKUP_UUID=1411e6f3-209c-4e53-9860-cf920a7fce2b
OLD_ROOT_PARTUUID=8b701eb6-c0d6-4422-95b7-1924c9d3f6b2
OLD_EFI_PARTUUID=63ec43fc-b35d-4ec4-a097-68ea3a6b645c

fail(){ echo "ERROR: $*" >&2; exit 1; }
[[ $EUID -eq 0 ]] || fail "run as root inside arch-chroot"

resolve_part(){ blkid -t "PARTUUID=$1" -o device | head -n1; }
ROOT_DEV="$(resolve_part "$ROOT_PARTUUID")"
BOOT_DEV="$(resolve_part "$BOOT_PARTUUID")"
[[ -b "$ROOT_DEV" ]] || fail "new root PARTUUID not found"
[[ -b "$BOOT_DEV" ]] || fail "new EFI PARTUUID not found"

ROOT_SOURCE="$(findmnt -no SOURCE /)"
ROOT_SOURCE="${ROOT_SOURCE%%[*}"
BOOT_SOURCE="$(findmnt -no SOURCE /boot)"
ROOT_FS="$(findmnt -no FSTYPE /)"
BOOT_FS="$(findmnt -no FSTYPE /boot)"
ROOT_OPTS="$(findmnt -no OPTIONS /)"

[[ "$ROOT_SOURCE" == "$ROOT_DEV" ]] || fail "active root is $ROOT_SOURCE, expected $ROOT_DEV"
[[ "$BOOT_SOURCE" == "$BOOT_DEV" ]] || fail "active /boot is $BOOT_SOURCE, expected $BOOT_DEV"
[[ "$ROOT_FS" == btrfs ]] || fail "root is not btrfs"
[[ "$BOOT_FS" == vfat ]] || fail "/boot is not vfat"
[[ "$ROOT_OPTS" == *"subvol=/@"* || "$ROOT_OPTS" == *"subvol=@"* ]] || fail "root is not @"
[[ "$(blkid -s UUID -o value "$ROOT_DEV")" == "$ROOT_UUID" ]] || fail "new root UUID mismatch"
[[ "$(blkid -s UUID -o value "$BOOT_DEV")" == "$BOOT_UUID" ]] || fail "new EFI UUID mismatch"
[[ "$ROOT_PARTUUID" != "$OLD_ROOT_PARTUUID" ]] || fail "old Arch root selected"
[[ "$BOOT_PARTUUID" != "$OLD_EFI_PARTUUID" ]] || fail "old Arch EFI selected"

# Confirm the migration partition still exists, but never mount/write it here.
BACKUP_DEV="$(blkid -t "UUID=$BACKUP_UUID" -o device | head -n1 || true)"
[[ -b "$BACKUP_DEV" ]] || fail "migration backup partition not detected"

echo "============================================================"
echo " GUARDED NEW ARCH BOOTSTRAP"
echo "============================================================"
echo "new root : $ROOT_DEV  PARTUUID=$ROOT_PARTUUID"
echo "new EFI  : $BOOT_DEV  PARTUUID=$BOOT_PARTUUID"
echo "backup   : $BACKUP_DEV (detected, not touched)"
echo "old Arch : protected"
echo "Windows  : not targeted"
echo

ln -sf /usr/share/zoneinfo/Asia/Dubai /etc/localtime
hwclock --systohc
sed -i 's/^#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
locale-gen
printf 'LANG=en_US.UTF-8\n' > /etc/locale.conf
printf 'KEYMAP=us\n' > /etc/vconsole.conf
printf '%s\n' "$HOST_NAME" > /etc/hostname
printf '127.0.0.1\tlocalhost\n::1\tlocalhost\n127.0.1.1\t%s.localdomain %s\n' "$HOST_NAME" "$HOST_NAME" > /etc/hosts

pacman -Syu --needed --noconfirm \
  linux linux-headers linux-firmware intel-ucode btrfs-progs \
  networkmanager openssh sudo zsh git base-devel vim nano curl \
  nvidia-open nvidia-utils mesa vulkan-intel intel-media-driver \
  hyprland xdg-desktop-portal-hyprland xdg-desktop-portal-gtk uwsm \
  firefox kitty waybar rofi wl-clipboard \
  pipewire pipewire-pulse wireplumber pavucontrol alsa-utils sof-firmware \
  bluez bluez-utils brightnessctl power-profiles-daemon \
  polkit-gnome network-manager-applet blueman xdg-user-dirs xdg-utils \
  noto-fonts noto-fonts-emoji ttf-firacode-nerd snapper snap-pac

if ! id "$USER_NAME" >/dev/null 2>&1; then
  useradd -m -G wheel,video,input -s /bin/zsh "$USER_NAME"
else
  usermod -aG wheel,video,input -s /bin/zsh "$USER_NAME"
fi
install -d -m 0755 /etc/sudoers.d
printf '%s ALL=(ALL:ALL) ALL\n' "$USER_NAME" > "/etc/sudoers.d/10-$USER_NAME"
chmod 0440 "/etc/sudoers.d/10-$USER_NAME"

HYPR_DIR="/home/$USER_NAME/.config/hypr"
install -d -o "$USER_NAME" -g "$USER_NAME" "$HYPR_DIR"
if [[ ! -e "$HYPR_DIR/hyprland.conf" ]]; then
cat > "$HYPR_DIR/hyprland.conf" <<'HYPR'
monitor=,preferred,auto,1
$mod = SUPER
bind = $mod, RETURN, exec, kitty
bind = $mod, F, exec, firefox
bind = $mod, Q, killactive,
bind = $mod, M, exit,
exec-once = waybar
exec-once = nm-applet --indicator
exec-once = blueman-applet
exec-once = /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
HYPR
chown "$USER_NAME:$USER_NAME" "$HYPR_DIR/hyprland.conf"
fi

systemctl enable NetworkManager.service
systemctl enable bluetooth.service
systemctl enable sshd.service
systemctl enable fstrim.timer
systemctl enable systemd-timesyncd.service
systemctl enable power-profiles-daemon.service

mkinitcpio -P

# Install systemd-boot files ONLY on the new p5 ESP. Do not touch firmware variables in chroot.
bootctl --esp-path=/boot --variables=no install
install -d -m 0755 /boot/loader/entries
cat > /boot/loader/loader.conf <<'LOADER'
default arch-new.conf
timeout 5
console-mode max
editor no
LOADER
cat > /boot/loader/entries/arch-new.conf <<EOF
title   Arch Linux (new)
linux   /vmlinuz-linux
initrd  /intel-ucode.img
initrd  /initramfs-linux.img
options root=UUID=$ROOT_UUID rootflags=subvol=@ rw
EOF

[[ -s /boot/vmlinuz-linux ]] || fail "kernel missing"
[[ -s /boot/initramfs-linux.img ]] || fail "initramfs missing"
[[ -s /boot/intel-ucode.img ]] || fail "intel microcode missing"
[[ -s /boot/EFI/systemd/systemd-bootx64.efi ]] || fail "systemd-boot EFI missing"
[[ -s /boot/EFI/BOOT/BOOTX64.EFI ]] || fail "fallback EFI loader missing"
bootctl --esp-path=/boot list >/root/bootctl-list.txt

# Password only if account is still locked/no password, making reruns safe.
PASS_STATE="$(passwd -S "$USER_NAME" | awk '{print $2}')"
if [[ "$PASS_STATE" != P ]]; then
  echo
  echo "============================================================"
  echo " SET PASSWORD FOR $USER_NAME"
  echo "============================================================"
  passwd "$USER_NAME"
fi
passwd -l root >/dev/null 2>&1 || true

# Helper to run AFTER exiting the chroot. It creates a one-shot UEFI entry only;
# BootOrder stays unchanged, so old Arch remains the automatic fallback.
cat > /root/finish-live.sh <<'LIVE'
#!/usr/bin/env bash
set -Eeuo pipefail
NEW_PARTUUID=54b861fd-685c-476f-b580-3051c1ba7d79
NEW_DEV="$(blkid -t "PARTUUID=$NEW_PARTUUID" -o device | head -n1)"
[[ -b "$NEW_DEV" ]] || { echo "ERROR: new EFI not found"; exit 1; }
[[ -f /mnt/boot/EFI/systemd/systemd-bootx64.efi ]] || { echo "ERROR: new systemd-boot missing"; exit 1; }
DISK="/dev/$(lsblk -no PKNAME "$NEW_DEV")"
PART="$(lsblk -no PARTN "$NEW_DEV")"
BEFORE="$(efibootmgr | sed -n 's/^BootOrder: //p')"
LINE="$(efibootmgr -v | grep -Fi 'Arch Linux New' | grep -Fi "$NEW_PARTUUID" | head -n1 || true)"
if [[ -z "$LINE" ]]; then
  efibootmgr -C -d "$DISK" -p "$PART" -L 'Arch Linux New' -l '\EFI\systemd\systemd-bootx64.efi'
  LINE="$(efibootmgr -v | grep -Fi 'Arch Linux New' | grep -Fi "$NEW_PARTUUID" | head -n1 || true)"
fi
BOOTNUM="$(sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\).*/\1/p' <<<"$LINE")"
[[ -n "$BOOTNUM" ]] || { echo "ERROR: could not identify new UEFI entry"; exit 1; }
AFTER="$(efibootmgr | sed -n 's/^BootOrder: //p')"
[[ "$BEFORE" == "$AFTER" ]] || { echo "ERROR: BootOrder changed unexpectedly"; exit 1; }
efibootmgr -n "$BOOTNUM"
echo
echo "ONE-SHOT NEW ARCH BOOT READY: Boot$BOOTNUM"
echo "BootOrder preserved: $BEFORE"
echo "If new Arch fails, the following reboot falls back to the existing BootOrder."
efibootmgr -v
LIVE
chmod +x /root/finish-live.sh

touch /root/ARCH_BOOTSTRAP_COMPLETE
sync

echo
echo "============================================================"
echo " BOOTSTRAP COMPLETE"
echo "============================================================"
echo "Old Arch and migration backup were not modified by this script."
echo "Now type exactly:"
echo "  exit"
echo "  bash /mnt/root/finish-live.sh"
echo "Then send the output BEFORE rebooting."
