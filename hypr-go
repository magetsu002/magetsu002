#!/usr/bin/env bash
set -Eeuo pipefail

[[ $(id -u) -ne 0 ]] || { echo 'Do not launch Hyprland as root'; exit 1; }

UID_NOW=$(id -u)
USER_NOW=$(id -un)
RUNTIME=/run/user/$UID_NOW

if [[ ! -d "$RUNTIME" ]]; then
  sudo install -d -m 700 -o "$USER_NOW" -g "$(id -gn)" "$RUNTIME"
fi
export XDG_RUNTIME_DIR="$RUNTIME"

mkdir -p "$HOME/.config/hypr"
curl -fsSL https://raw.githubusercontent.com/magetsu002/magetsu002/a/hypr-minimal.lua -o "$HOME/.config/hypr/hyprland.lua"
rm -f "$HOME/.config/hypr/hyprland.conf"

exec start-hyprland
